<dependencies>
  <androidPackages>
    <!-- Android stays on 6.20.0.0 for Unity 2022.3, whose Android Gradle Plugin is 7.4.2: 6.21 breaks D8 there,
         and 6.22 needs AGP 8.9.1 and compileSdk 36 for androidx.browser 1.9.0. iOS keeps 6.22.0.0. -->
    <androidPackage spec="com.google.ads.mediation:facebook:6.20.0.0">
      <repositories>
        <repository>https://repo.maven.apache.org/maven2/</repository>
        <repository>https://dl.google.com/dl/android/maven2/</repository>
      </repositories>
    </androidPackage>
  </androidPackages>

  <iosPods>
    <iosPod name="GoogleMobileAdsMediationFacebook" version="6.22.0.0"/>
    <iosPod name="FBAudienceNetwork" addToAllTargets="true"/>
  </iosPods>
</dependencies>
